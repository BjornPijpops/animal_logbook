# Copy to a file OUTSIDE the repository, e.g. /etc/animal-logbook/.env.production (chmod 600), then
# replace every value. The app refuses to start on placeholders. See docs/DEPLOYMENT.md.

# Public hostname (no scheme). DNS must point at this server. Caddy gets a certificate for it.
APP_DOMAIN=logbook.example.org
# Contact address for Let's Encrypt (expiry notices).
ACME_EMAIL=admin@logbook.example.org

# Secrets. Generate each with: openssl rand -hex 32   (hex avoids URL-encoding problems)
AUTH_SECRET=change-me
FILE_TOKEN_SECRET=change-me
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
WORKER_DB_PASSWORD=change-me

# Outgoing email: any SMTP server (own server, or a free relay account). Test it with
#   docker compose --env-file <file> -f docker-compose.prod.yml run --rm worker node dist/send-test-email.mjs you@x.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS (port 465), false for STARTTLS (587)
SMTP_SECURE=false
EMAIL_FROM=Animal Logbook <logbook@your-domain>

# Web Push keys (optional, all or none). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain

# Optional tuning
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
EXPORT_MAX_MB=300
VIRUS_SCANNER=none
LOG_LEVEL=info
# Image to run; CI publishes ghcr.io/<owner>/<repo>:<git sha>. Default builds locally.
# APP_IMAGE=animal-logbook:local