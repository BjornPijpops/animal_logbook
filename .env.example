# Copy to .env.local. Placeholders only; never commit real secrets.

NODE_ENV=development
APP_URL=http://localhost:3000

# Postgres (docker compose)
# Three database roles (ADR 0015). Migrations, seeds and test fixtures use the OWNER role. The web app
# connects as animal_app and the worker as animal_worker; neither owns tables, so row-level security
# applies to them. `npm run db:migrate` creates the roles, `npm run db:roles` gives them passwords.
DATABASE_OWNER_URL=postgres://animal:animal@localhost:5432/animal_logbook
DATABASE_URL=postgres://animal_app:animal_app@localhost:5432/animal_logbook
WORKER_DATABASE_URL=postgres://animal_worker:animal_worker@localhost:5432/animal_logbook
APP_DB_PASSWORD=animal_app
WORKER_DB_PASSWORD=animal_worker
# Tests: this is the owner role; the suite derives the app and worker role URLs from it.
TEST_DATABASE_URL=postgres://animal:animal@localhost:5432/animal_logbook_test

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Optional OAuth providers: enabled only when both values are set
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File storage
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
HOUSEHOLD_QUOTA_MB=500
# Soft-deleted rows and files are purged for good after this many days (ADR 0016)
RETENTION_DAYS=30
# Signs short-lived download tokens (generate: openssl rand -base64 32)
FILE_TOKEN_SECRET=change-me-too
FILE_TOKEN_TTL_SECONDS=300

# Virus scanning (disabled by default)
VIRUS_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Email (Mailpit in dev: UI at http://localhost:8025). Any SMTP server in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Animal Logbook <no-reply@localhost>"

# Web Push (generate: npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
# Dev/test only: allow push endpoints on localhost or private addresses (SSRF guard otherwise).
ALLOW_LOCAL_PUSH_ENDPOINTS=false

# Reminders: anything due longer ago than this is marked expired and never sent.
REMINDER_STALE_WINDOW_HOURS=24
# A scheduled dose with no log this long after its time is recorded as missed.
DOSE_MISSED_AFTER_HOURS=4

# Reverse proxy: trust X-Forwarded-For ONLY if a proxy you control overwrites it (see ADR 0007).
# Off by default: auth rate limits then share one bucket per path instead of trusting client headers.
TRUSTED_PROXY=false
# Optional comma-separated proxy IPs/CIDRs to strip from the right of X-Forwarded-For
TRUSTED_PROXY_CIDRS=

# Logging
LOG_LEVEL=debug